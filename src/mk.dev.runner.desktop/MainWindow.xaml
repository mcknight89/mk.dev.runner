<Window x:Class="mk.dev.runner.desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:mk.dev.runner.desktop.Controls"
        Title="Dev Runner" Width="1280" Height="820" MinWidth="820" MinHeight="520"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Projects sidebar ── -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                    <TextBlock x:Name="AppTitle" Text="Dev Runner" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Projects" Foreground="{StaticResource Faint}" Margin="0,10,0,0" FontSize="11"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10">
                    <Button Content="+ Add" Command="{Binding AddProject}" ToolTip="Add a project folder (its config is found in its root)"/>
                    <Button Content="Import folder" Command="{Binding ImportFolder}" Margin="6,0,0,0" ToolTip="Add every project in a folder and the folders directly inside it"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE713;" Command="{Binding OpenSettings}" Margin="6,0,0,0" ToolTip="Settings" AutomationProperties.Name="Settings"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Updates.Status}" Foreground="{StaticResource Faint}" FontSize="11"
                           TextWrapping="Wrap" Margin="12,4,12,0" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Vis}}"
                           ToolTip="{Binding Updates.StatusDetail}"/>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource Primary}" Margin="10,0,10,0" Command="{Binding InstallUpdate}"
                        Visibility="{Binding Updates.HasUpdate, Converter={StaticResource Vis}}" ToolTip="{Binding Updates.Status}">
                    <TextBlock>
                        <Run Text="Update to"/> <Run Text="{Binding Updates.Available, Mode=OneWay}"/>
                    </TextBlock>
                </Button>
                <ListBox ItemsSource="{Binding Projects}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ProjectItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="6,1,0,0"
                                           MinWidth="48" TextAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Empty state ── -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasSelection, Converter={StaticResource NotVis}}">
            <TextBlock Text="No projects yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="Add a project's folder. Its config file in the root (.dev.json, or any name you pick) says what to run."
                       Foreground="{StaticResource Muted}" Margin="0,8,0,16" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Primary}" Content="Add project folder" Command="{Binding AddProject}"/>
                <Button Content="Import folder" Command="{Binding ImportFolder}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ── Selected project ── -->
        <Grid Grid.Column="1" DataContext="{Binding Selected}"
              Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="CardsRow" Height="Auto" MinHeight="120"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Margin="20,16,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                    <TextBlock TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <Run Text="{Binding ModeText, Mode=OneWay}" Foreground="{StaticResource Faint}"/>
                        <Run Text="{Binding BuildText, Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                        <Run Text="{Binding BusyText, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding ConfigPath}" Foreground="{StaticResource Faint}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding ConfigPath}"/>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding HasError, Converter={StaticResource Vis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Primary}" Content="Start all" Command="{Binding StartAll}" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Start every enabled service (F5). Greyed out when there's nothing to start."/>
                    <Button Content="Stop all" Command="{Binding StopAll}" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Stop every service (Shift+F5). Greyed out when nothing is running."/>
                    <Button Content="Restart all" Command="{Binding RestartAll}" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"
                            ToolTip="Restart every running service (Ctrl+Shift+F5). Greyed out when nothing is running."/>
                    <Button Content="Edit project" Command="{Binding EditProject}" Margin="6,0,0,0"
                            ToolTip="Edit the project's settings and its list of services. Changed services restart when you save."/>
                    <Button Content="Environment" Command="{Binding EditEnv}" Margin="6,0,0,0" ToolTip="Edit environment variables"/>
                    <Button x:Name="MoreButton" Style="{StaticResource Icon}" Content="&#xE712;" Margin="6,0,0,0" ToolTip="More" AutomationProperties.Name="More" Click="More_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Start when Dev Runner opens" IsCheckable="True" IsChecked="{Binding AutoStart}"/>
                                <MenuItem Header="Clean rebuild" Command="{Binding CleanRebuild}"
                                          Visibility="{Binding IsManaged, Converter={StaticResource Vis}}"/>
                                <Separator/>
                                <MenuItem Header="Edit project…" Command="{Binding EditProject}"/>
                                <MenuItem Header="Rename…" Command="{Binding Rename}"/>
                                <MenuItem Header="Open project folder" Command="{Binding OpenFolder}"/>
                                <MenuItem Header="Edit config file" Command="{Binding EditConfig}"/>
                                <MenuItem Header="Reload config" Command="{Binding Reload}"/>
                                <Separator/>
                                <MenuItem Header="Open build log" Command="{Binding ViewBuildLog}"
                                          Visibility="{Binding IsManaged, Converter={StaticResource Vis}}"/>
                                <MenuItem Header="Open logs folder" Command="{Binding OpenLogs}"/>
                                <Separator/>
                                <MenuItem Header="Remove from list…" Command="{Binding Remove}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- totals -->
            <TextBlock Grid.Row="1" Margin="20,0,20,6" Foreground="{StaticResource Muted}">
                <Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text="   "/><Run Text="{Binding MemoryText, Mode=OneWay}"/>
            </TextBlock>

            <!-- service cards -->
            <ListBox Grid.Row="2" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" Margin="14,0,14,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid VerticalAlignment="Top"
                                     Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource CardColumns}}"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="card" Margin="6" CornerRadius="8" Background="{StaticResource Card}"
                                            BorderBrush="{StaticResource Border}" BorderThickness="1" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Faint}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding ColorBrush}" CornerRadius="8,0,0,8"/>
                            <StackPanel Grid.Column="1" Margin="12,10,12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding StateBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding PortText, Mode=OneWay}" Foreground="{StaticResource Faint}"/>
                                    </TextBlock>
                                    <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="{Binding EnabledText}"
                                              Foreground="{StaticResource Muted}" FontSize="11.5"
                                              ToolTip="Enabled on this machine. Off means Start all skips it until you turn it back on (it's saved). To stop it just for now, use Stop."/>
                                    <Button Grid.Column="3" Style="{StaticResource Icon}" Content="&#xE70F;" Command="{Binding Edit}" Margin="8,-4,-4,-4"
                                            ToolTip="Edit this service: port, address, health check, command" AutomationProperties.Name="Edit service"/>
                                </Grid>
                                <TextBlock Margin="17,2,0,0" FontSize="12" Text="{Binding StateText}" Foreground="{Binding StateBrush}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ToolTip>
                                        <TextBlock Text="{Binding ProcessTip}" FontFamily="{StaticResource Mono}" FontSize="12"/>
                                    </Grid.ToolTip>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding MemoryText}" FontSize="19" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="{StaticResource Muted}" FontSize="11.5">
                                            <Run Text="{Binding CpuText, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding PeakText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="120" Height="30" VerticalAlignment="Center">
                                        <Polyline Points="{Binding Sparkline}" Stroke="{Binding ColorBrush}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding DetailText}" Foreground="{StaticResource Faint}" FontSize="11" Margin="0,6,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Command="{Binding StartStop}" Padding="12,3">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Primary}">
                                                <Setter Property="Content" Value="Start"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Content" Value="Stop"/>
                                                        <Setter Property="Background" Value="{StaticResource Card}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Restart" Command="{Binding Restart}" Padding="10,3" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Restart this service. Greyed out while it's stopped."/>
                                    <Button Content="Browser" Command="{Binding OpenUrl}" Padding="7,3" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Open in the browser. Greyed out when the service has no port."/>
                                    <Button Content="Log" Command="{Binding OpenLog}" Padding="7,3" Margin="4,0,0,0" ToolTip="Open this run's log in Dev Runner"/>
                                    <Button Content="Folder" Command="{Binding OpenFolder}" Padding="7,3" Margin="4,0,0,0" ToolTip="Open the service's folder"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" Background="{StaticResource Border}" Height="1" VerticalAlignment="Center"/>
            <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="Transparent" Height="5" ResizeDirection="Rows" Cursor="SizeNS"/>

            <!-- logs -->
            <DockPanel Grid.Row="4">
                <Grid DockPanel.Dock="Top" Background="{StaticResource Panel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding LogSources}" SelectedItem="{Binding SelectedLog}" ItemContainerStyle="{StaticResource TabItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" Margin="10,0,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding ColorHex, Converter={StaticResource HexBrush}}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
                <c:LogView x:Name="Log" Lines="{Binding SelectedLog.Lines}" ClearCommand="{Binding ClearLog}"
                           EmptyText="No output yet. Start a service to see its log here."/>
            </DockPanel>
        </Grid>

        <!-- stopping overlay -->
        <Border x:Name="Stopping" Grid.ColumnSpan="2" Background="#CC18181B" Visibility="Collapsed">
            <TextBlock Text="Stopping all services…" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
