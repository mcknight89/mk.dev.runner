<UserControl x:Class="mk.dev.runner.desktop.Controls.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:mk.dev.runner.desktop.Controls"
             x:Name="Root">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="8,5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ErrorsOnly" Style="{StaticResource Switch}" Content="Errors only" Foreground="{StaticResource Muted}"
                              Checked="Filter_Changed" Unchecked="Filter_Changed" Margin="12,0,0,0" ToolTip="Show only lines with error, fail, exception or fatal"/>
                    <CheckBox x:Name="Wrap" Style="{StaticResource Switch}" Content="Wrap" Foreground="{StaticResource Muted}"
                              Checked="Wrap_Changed" Unchecked="Wrap_Changed" Margin="14,0,8,0" ToolTip="Wrap long lines"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE8C8;" Click="CopyAll_Click" ToolTip="Copy the whole log" AutomationProperties.Name="Copy the whole log"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE74B;" Click="Bottom_Click" ToolTip="Go to the bottom and follow new lines" AutomationProperties.Name="Go to the bottom"/>
                    <Button x:Name="ClearButton" Style="{StaticResource Icon}" Content="&#xE894;" Command="{Binding ClearCommand, ElementName=Root}"
                            ToolTip="Clear this view" AutomationProperties.Name="Clear this view"/>
                    <Button x:Name="EditorButton" Style="{StaticResource Icon}" Content="&#xE70F;" Click="Editor_Click"
                            ToolTip="Open the file in VS Code" AutomationProperties.Name="Open the file in VS Code"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="240">
                        <TextBox x:Name="Search" TextChanged="Search_TextChanged" KeyDown="Search_KeyDown" Padding="6,2"
                                 AutomationProperties.Name="Find in log"/>
                        <TextBlock Text="Find (Ctrl+F)" Foreground="{StaticResource Faint}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Style="{StaticResource Icon}" Content="&#xE70E;" Command="{Binding PreviousCommand, ElementName=Root}" Margin="4,0,0,0"
                            ToolTip="Previous match (Shift+Enter)" AutomationProperties.Name="Previous match"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE70D;" Command="{Binding NextCommand, ElementName=Root}"
                            ToolTip="Next match (Enter)" AutomationProperties.Name="Next match"/>
                    <TextBlock x:Name="MatchCount" Foreground="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid>
            <c:LogListBox x:Name="List" Background="{StaticResource LogBg}" BorderThickness="0"
                          FontFamily="{StaticResource Mono}" FontSize="12" Padding="0,4"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" ItemContainerStyle="{StaticResource PlainItem}">
                <c:LogListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Seq}" Foreground="#52525b" TextAlignment="Right" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" c:AnsiText.Line="{Binding}" Foreground="#D4D4D8"
                                       c:AnsiText.Highlight="{Binding SearchText, ElementName=Root}"
                                       TextWrapping="{Binding WrapMode, ElementName=Root}"/>
                        </Grid>
                    </DataTemplate>
                </c:LogListBox.ItemTemplate>
            </c:LogListBox>
            <TextBlock x:Name="EmptyHint" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
    </DockPanel>
</UserControl>
