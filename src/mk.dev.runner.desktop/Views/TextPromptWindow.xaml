<Window x:Class="mk.dev.runner.desktop.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBlock x:Name="Prompt" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBox x:Name="Value"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True"/>
            <Button x:Name="OkButton" Content="Save" Style="{StaticResource Primary}" Click="Ok_Click" Margin="8,0,0,0" Padding="18,5" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
