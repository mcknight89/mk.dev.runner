<Window x:Class="mk.dev.runner.desktop.Views.ProjectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit project" Width="1000" Height="820" MinWidth="820" MinHeight="560"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <DataTemplate x:Key="DarkText">
            <TextBlock Text="{Binding}"/>
        </DataTemplate>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10,14,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>

        <!-- project -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="8" Padding="14,4,14,12" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Name in Dev Runner"/>
                    <TextBox x:Name="ProjectName"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Label}" Text="How dotnet services run"/>
                    <ComboBox x:Name="DotnetMode" SelectionChanged="DotnetMode_Changed" ItemTemplate="{StaticResource DarkText}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource Label}" Text="Solution (for managed builds)"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseSolution_Click" Margin="6,0,0,0" Padding="10,3"/>
                        <TextBox x:Name="Solution"/>
                    </DockPanel>
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <CheckBox x:Name="AutoRetry" Style="{StaticResource Switch}" Content="Restart a service when it crashes" VerticalAlignment="Center"/>
                    <TextBlock Text="up to" Foreground="{StaticResource Muted}" Margin="16,0,6,0" VerticalAlignment="Center"/>
                    <TextBox x:Name="MaxRetries" Width="44" TextAlignment="Center"/>
                    <TextBlock Text="times in a row" Foreground="{StaticResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="AutoRebuild" Style="{StaticResource Switch}" Content="Rebuild when code changes (managed)" Margin="28,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- services -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Services" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="+ Add service" Click="Add_Click"/>
                    <Button Content="Remove" Style="{StaticResource Danger}" Click="Remove_Click" Margin="6,0,0,0"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE70E;" Click="Up_Click" Margin="6,0,0,0" ToolTip="Move up" AutomationProperties.Name="Move up"/>
                    <Button Style="{StaticResource Icon}" Content="&#xE70D;" Click="Down_Click" ToolTip="Move down" AutomationProperties.Name="Move down"/>
                </StackPanel>
                <ListBox x:Name="List" Background="{StaticResource Panel}" ItemContainerStyle="{StaticResource ProjectItem}"
                         SelectionChanged="List_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer x:Name="FormScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Form" Margin="0,0,8,0">
                    <TextBlock x:Name="NoService" Text="Add a service to run: an API, a web app, or any command." Foreground="{StaticResource Muted}" Margin="0,24,0,0"/>
                    <StackPanel x:Name="ServiceForm">

                        <!-- what it is -->
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Service"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="Name"/>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label}" Text="Key"/>
                                        <TextBox Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Short id used in the config, e.g. api"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Label}" Text="Folder"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseDir_Click" Margin="6,0,0,0" Padding="10,3"/>
                                    <TextBox Text="{Binding Dir, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Text="Relative to the project's folder, e.g. myapp.api"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="Colour"/>
                                        <ComboBox x:Name="ColorBox" SelectedItem="{Binding Color}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,8,0" Background="{Binding Converter={StaticResource ColorName}}"/>
                                                        <TextBlock Text="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Content="Enabled by default"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="Each machine can still switch it off for itself."/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- where it lives and how to tell it's up -->
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Address and health"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Label}" Text="Port"/>
                                        <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource Label}" Text="Address"/>
                                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding PortHint}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding AddressHint}"/>

                                <TextBlock Style="{StaticResource Label}" Text="Health check" Margin="0,14,0,4"/>
                                <ComboBox x:Name="HealthBox" SelectedItem="{Binding Health}" ItemTemplate="{StaticResource DarkText}" Width="200" HorizontalAlignment="Left"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{Binding HealthHint}"/>
                                <StackPanel Visibility="{Binding HealthValueVisible}">
                                    <TextBlock Style="{StaticResource Label}" Text="{Binding HealthValueLabel}"/>
                                    <TextBox Text="{Binding HealthValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{Binding HealthValueHint}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- how it starts -->
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitle}" Text="How it starts"/>
                                <TextBlock Style="{StaticResource Label}" Text="Type"/>
                                <ComboBox x:Name="TypeBox" SelectedItem="{Binding Type}" ItemTemplate="{StaticResource DarkText}" Width="200" HorizontalAlignment="Left"/>
                                <StackPanel x:Name="NpmFields">
                                    <TextBlock Style="{StaticResource Label}" Text="npm script"/>
                                    <TextBox Text="{Binding Script, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Runs npm run &lt;script&gt;. Empty = dev."/>
                                </StackPanel>
                                <StackPanel x:Name="CommandFields">
                                    <TextBlock Style="{StaticResource Label}" Text="Command"/>
                                    <TextBox Text="{Binding Cmd, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="Any program, .cmd or .bat, e.g. node, python, docker"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Label}" Text="Arguments"/>
                                <TextBox Text="{Binding Args, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}"/>
                                <TextBlock x:Name="ArgsHint" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Status" Foreground="{StaticResource Bad}" TextWrapping="Wrap"/>
                <TextBlock x:Name="FilePath" Foreground="{StaticResource Faint}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,190,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Cancel" IsCancel="True"/>
                <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click" Margin="8,0,0,0" Padding="18,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
