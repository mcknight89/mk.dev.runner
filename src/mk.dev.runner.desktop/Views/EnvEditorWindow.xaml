<Window x:Class="mk.dev.runner.desktop.Views.EnvEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environment" Width="980" Height="620" MinWidth="700" MinHeight="400"
        Style="{StaticResource DarkWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Local values are for this machine only (kept in the project's .devrunner\local.json, never committed). Shared values go in the config file, so they're committed with the project: don't put secrets there. A service's own values win over the project's, and local wins over shared."/>
        </StackPanel>

        <ListBox x:Name="Scopes" Grid.Row="1" ItemContainerStyle="{StaticResource ProjectItem}" Margin="0,0,12,0"
                 SelectionChanged="Scopes_SelectionChanged" Background="{StaticResource Panel}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- variables -->
        <Grid x:Name="VarsPanel" Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="+ Add variable" Click="Add_Click"/>
                <Button Content="Delete selected" Style="{StaticResource Danger}" Click="Delete_Click" Margin="6,0,0,0"/>
                <Button Content="Paste .env text…" Click="Paste_Click" Margin="6,0,0,0" ToolTip="Add KEY=VALUE lines from the clipboard"/>
                <CheckBox x:Name="Mask" Style="{StaticResource Switch}" Content="Hide values" Margin="16,0,0,0" VerticalAlignment="Center"
                          Checked="Mask_Changed" Unchecked="Mask_Changed"/>
            </StackPanel>
            <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                      SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                    <DataGridTextColumn x:Name="ValueColumn" Header="Value" Binding="{Binding DisplayValue, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTemplateColumn Header="Kept" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Where}" Command="{Binding ToggleWhere}" Padding="10,1" Margin="0,1"
                                        HorizontalAlignment="Left" ToolTip="Click to switch between Local (this machine) and Shared (config file)"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock x:Name="InheritedTitle" Text="Also gets (from All services)" Foreground="{StaticResource Muted}" FontSize="12"/>
                <TextBlock x:Name="Inherited" Foreground="{StaticResource Faint}" FontFamily="{StaticResource Mono}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- .env file -->
        <Grid x:Name="FilePanel" Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="FileNote" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <TextBox x:Name="FileText" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="{StaticResource Mono}"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
        </Grid>

        <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <TextBlock x:Name="Status" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource Primary}" Click="Save_Click" Margin="8,0,0,0" Padding="18,5"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
